# Gemaakt door scripts/overnemen-van-testsite.sh. Niet met de hand aanpassen.
DirectoryIndex index.html

# Altijd via https en zonder www op dbreininghorses.be
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^dbreininghorses\.be$ [NC]
RewriteRule ^ https://dbreininghorses.be%{REQUEST_URI} [L,R=301]

# /index.html naar /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ https://dbreininghorses.be/ [L,R=301]

# Foto's, lettertypes en icoontjes mogen lang in de browser blijven
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
